 *
 * Kopiere diese Datei als "config.local.php" und fülle die Werte aus.
 * Auf dem Produktionsserver liegt sie unter: includes/config.local.php
 */

// ── Datenbank (Produktion) ──────────────────────────────────
if (!defined('DB_HOST')) define('DB_HOST', '127.0.0.1');
if (!defined('DB_PORT')) define('DB_PORT', 3307);
if (!defined('DB_USER')) define('DB_USER', 'h235337_immobilienghumman');
if (!defined('DB_PASS')) define('DB_PASS', 'DEIN_SICHERES_DB_PASSWORT');
if (!defined('DB_NAME')) define('DB_NAME', 'h235337_immobilienghumman');

// ── Socket-SMTP-Mailer (E-Mail-Versand) ─────────────────────
if (!defined('MAILER_DRIVER')) define('MAILER_DRIVER', 'socket_smtp');
if (!defined('SMTP_HOST'))     define('SMTP_HOST', 'smtp.ionos.de');
if (!defined('SMTP_PORT'))     define('SMTP_PORT', 587);
if (!defined('SMTP_USER'))     define('SMTP_USER', 'dein-postfach@immobilienghumman.de');
if (!defined('SMTP_PASS'))     define('SMTP_PASS', 'DEIN_SMTP_PASSWORT');
if (!defined('SMTP_SECURE'))   define('SMTP_SECURE', 'tls'); // tls|ssl|none
if (!defined('SMTP_AUTH'))     define('SMTP_AUTH', true); // IONOS: erforderlich
if (!defined('SMTP_TIMEOUT'))  define('SMTP_TIMEOUT', 20);

// ── Cloudinary (Bild-Upload) ───────────────────────────────
if (!defined('CLOUDINARY_CLOUD_NAME')) define('CLOUDINARY_CLOUD_NAME', 'dlpdbr0ey');
if (!defined('CLOUDINARY_API_KEY'))    define('CLOUDINARY_API_KEY',    'DEIN_CLOUDINARY_API_KEY');
if (!defined('CLOUDINARY_API_SECRET')) define('CLOUDINARY_API_SECRET', 'DEIN_CLOUDINARY_API_SECRET');

// ── Sicherheit ─────────────────────────────────────────────
// Zufälliger langer String (mindestens 32 Zeichen), z.B. via: openssl rand -hex 32
if (!defined('AUTH_SECRET')) define('AUTH_SECRET', 'HIER_ZUFAELLIGEN_STRING_64_ZEICHEN_EINTRAGEN');

// ── Cloudflare Turnstile ───────────────────────────────────
